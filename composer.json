{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "petecoop/livewire-vite-react",
    "description": "Vite-powered component scripts and React integration for Livewire.",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.2",
        "illuminate/support": "^11.0|^12.0|^13.0",
        "livewire/livewire": "^4.0"
    },
    "autoload": {
        "psr-4": {
            "LivewireViteReact\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "LivewireViteReact\\LivewireViteReactServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}

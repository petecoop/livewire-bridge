{
    "extends": "./tsconfig.json",
    "compilerOptions": {
        "declaration": false,
        "declarationMap": false,
        "noEmit": true,
        "types": [
            "node",
            "vitest/globals"
        ]
    },
    "include": [
        "src/**/*.ts",
        "src/**/*.tsx",
        "tests/JavaScript/**/*.ts",
        "tests/JavaScript/**/*.tsx",
        "tests/Fixtures/**/*.ts",
        "vitest.config.ts"
    ]
}

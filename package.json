{
    "name": "@petecoop/livewire-bridge",
    "version": "0.0.0",
    "description": "Vite-powered client components and scripts for Livewire.",
    "license": "MIT",
    "type": "module",
    "publishConfig": {
        "access": "public"
    },
    "sideEffects": false,
    "files": [
        "dist"
    ],
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js"
        },
        "./react": {
            "types": "./dist/react-runtime.d.ts",
            "import": "./dist/react-runtime.js"
        },
        "./package.json": "./package.json"
    },
    "scripts": {
        "build": "tsdown",
        "dev": "tsdown --watch",
        "release": "release-it",
        "release:dry-run": "release-it --dry-run",
        "test": "npm run test:js && npm run test:php",
        "test:js": "npm run typecheck && vitest run",
        "test:js:watch": "vitest",
        "test:fixture:build": "npm run build && vite build --config tests/Fixtures/vite.config.ts",
        "test:php": "npm run test:fixture:build && vendor/bin/pest --exclude-group=browser",
        "test:browser": "npm run test:fixture:build && vendor/bin/pest --group=browser",
        "typecheck": "tsc --noEmit -p tsconfig.test.json",
        "prepublishOnly": "npm run build"
    },
    "peerDependencies": {
        "react": ">=18.0.0",
        "react-dom": ">=18.0.0",
        "vite": ">=6.0.0"
    },
    "devDependencies": {
        "@testing-library/react": "^16.3.2",
        "@types/node": "^26.1.1",
        "@types/react": "^19.0.0",
        "jsdom": "^29.1.1",
        "playwright": "^1.61.1",
        "react": "^19.2.0",
        "react-dom": "^19.2.0",
        "release-it": "^20.2.1",
        "tsdown": "latest",
        "typescript": "^6.0.3",
        "vite": "^8.0.0",
        "vitest": "^4.1.10"
    }
}
